{
  "name": "study-pet",
  "productName": "Study Pet",
  "version": "0.1.0",
  "description": "친구들끼리 같이 쓰는 공부 데스크톱 펫",
  "main": "src/main/main.js",
  "author": "leehyoeun",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --devtools",
    "start:nogpu": "electron . --no-gpu",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.studypet.app",
    "productName": "Study Pet",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "identity": null,
      "extendInfo": {
        "LSUIElement": true
      }
    }
  },
  "devDependencies": {
    "electron": "^45.0.0"
  }
}
