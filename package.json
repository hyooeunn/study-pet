{
  "name": "study-pet",
  "productName": "Study Pet",
  "version": "0.1.0",
  "description": "친구들끼리 같이 쓰는 공부 데스크톱 펫",
  "main": "out/main/main.js",
  "author": "leehyoeun",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "start:nogpu": "node scripts/build.mjs && electron . --no-gpu",
    "typecheck": "tsc -b",
    "dist:win": "node scripts/build.mjs && electron-builder --win --publish never",
    "dist:mac": "node scripts/build.mjs && electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.studypet.app",
    "productName": "Study Pet",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "!out/**/*.map",
      "!out/**/*.d.ts",
      "!out/**/.tsbuildinfo*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "identity": null,
      "extendInfo": {
        "LSUIElement": true
      }
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "electron": "^45.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
